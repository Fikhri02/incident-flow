<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Behaviour specs (Reqnroll + xUnit) a tech lead can read: the incident lifecycle,
    the detection threshold and the ingestion rate limit, each run against the real code.
    The detection feature needs Docker (Testcontainers Redis).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Reqnroll.xUnit" Version="3.3.4" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Testcontainers.Redis" Version="3.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\IncidentFlow.Services.Incident.Api\IncidentFlow.Services.Incident.Api.csproj" />
    <ProjectReference Include="..\..\src\Services\IncidentFlow.Services.Detection.Worker\IncidentFlow.Services.Detection.Worker.csproj" />
    <ProjectReference Include="..\..\src\Services\IncidentFlow.Services.Ingestion.Api\IncidentFlow.Services.Ingestion.Api.csproj" />
  </ItemGroup>

</Project>
