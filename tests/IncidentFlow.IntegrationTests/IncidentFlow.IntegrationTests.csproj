    <ProjectReference Include="..\..\src\Services\IncidentFlow.Services.Incident.Api\IncidentFlow.Services.Incident.Api.csproj" Aliases="incidentapi" />
    <ProjectReference Include="..\..\src\Services\IncidentFlow.Services.Timeline.Api\IncidentFlow.Services.Timeline.Api.csproj" />
    <ProjectReference Include="..\..\src\Services\IncidentFlow.Services.Notification.Worker\IncidentFlow.Services.Notification.Worker.csproj" />
